# Lingkungan Python lokal
.venv/
venv/
env/

# Cache Python dan alat pemeriksaan
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Salinan otomatis Jupyter
.ipynb_checkpoints/

# File sementara, log, dan cadangan kerja lokal
/tmp/
*.tmp
*.log

# Checkpoint rolling yang dapat dibuat ulang
/hasil_tanpa_filter/checkpoint/

# Versi artikel: simpan tabel/gambar artikel; keluaran rinci dapat dibuat ulang.
/hasil_artikel/data_processed/
/hasil_artikel/tabel/*
!/hasil_artikel/tabel/tabel_[1-5]_*.csv
!/hasil_artikel/tabel/tabel_[1-5]_*.html
/hasil_artikel/grafik/02_normalitas.png
/hasil_artikel/grafik/03_acf.png
/hasil_artikel/grafik/04_bobot.png

# Eksperimen pembobotan: hasil rinci tetap lokal dan dapat dibuat ulang.
/hasil_3_pembobotan/data_processed/
/hasil_3_pembobotan/tabel/*
!/hasil_3_pembobotan/tabel/tabel_[1-5]_*.csv
!/hasil_3_pembobotan/tabel/tabel_[1-5]_*.html

# Konfigurasi rahasia lokal; contoh konfigurasi tetap boleh dilacak
.env
.env.*
!.env.example
!.env.sample

# Metadata sistem operasi
.DS_Store
Thumbs.db
Desktop.ini

